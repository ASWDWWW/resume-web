{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/shell-guard.mjs",
        "timeout": 10
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "node .cursor/hooks/mcp-guard.mjs",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/secret-prompt.mjs",
        "timeout": 10
      }
    ],
    "beforeReadFile": [
      {
        "command": "node .cursor/hooks/restricted-read.mjs",
        "timeout": 10
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/audit-edit.mjs",
        "timeout": 10
      }
    ]
  }
}
